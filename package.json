    "snipcss",
    "css",
    "tailwind",
    "design-extraction",
    "playwright",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "1.0.0",
